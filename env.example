# Railway ichida bu qiymatlarni "Variables" bo'limiga kiriting (bu faylni GitHub ga yuklamang)
NODE_ENV=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
# 48+ ta tasodifiy belgi:  openssl rand -base64 48
APP_SECRET=
# Faqat birinchi ishga tushirishda egasi (owner) akkauntini yaratadi
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Owner
# Railway Volume ulangan joy
DATA_DIR=/data
